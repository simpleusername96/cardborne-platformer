class_name RunPhase
extends RefCounted

const NORMAL_STAGE_COUNT := 3

enum Value {
	BOOT,
	MAIN_MENU,
	PREPARATION,
	TRIAL_LOADING,
	TRIAL_ACTIVE,
	LOADOUT,
	STAGE_LOADING,
	STAGE_ACTIVE,
	LEVEL_REWARD,
	STAGE_CARD_REWARD,
	INTERMISSION_LOADING,
	INTERMISSION_ACTIVE,
	BOSS_LOADING,
	BOSS_ACTIVE,
	RETRY_DECISION,
	RUN_DEATH,
	RUN_CLEAR,
}

const LEGAL_TRANSITIONS: Dictionary = {
	Value.BOOT: [Value.MAIN_MENU],
	Value.MAIN_MENU: [Value.PREPARATION],
	Value.PREPARATION: [Value.MAIN_MENU, Value.LOADOUT, Value.TRIAL_LOADING],
	Value.TRIAL_LOADING: [Value.TRIAL_ACTIVE, Value.PREPARATION, Value.RUN_DEATH],
	Value.TRIAL_ACTIVE: [Value.PREPARATION, Value.RUN_DEATH],
	Value.LOADOUT: [Value.PREPARATION, Value.STAGE_LOADING],
	Value.STAGE_LOADING: [Value.STAGE_ACTIVE, Value.MAIN_MENU, Value.RUN_DEATH],
	Value.STAGE_ACTIVE: [
		Value.LEVEL_REWARD, Value.STAGE_CARD_REWARD, Value.RETRY_DECISION,
		Value.RUN_DEATH,
	],
	Value.LEVEL_REWARD: [
		Value.LEVEL_REWARD, Value.STAGE_ACTIVE, Value.STAGE_CARD_REWARD,
		Value.RUN_DEATH,
	],
	Value.STAGE_CARD_REWARD: [
		Value.INTERMISSION_LOADING, Value.RUN_DEATH,
	],
	Value.INTERMISSION_LOADING: [Value.INTERMISSION_ACTIVE, Value.RUN_DEATH],
	Value.INTERMISSION_ACTIVE: [
		Value.STAGE_LOADING, Value.BOSS_LOADING, Value.RUN_DEATH,
	],
	Value.BOSS_LOADING: [Value.BOSS_ACTIVE, Value.RUN_DEATH],
	Value.BOSS_ACTIVE: [Value.RETRY_DECISION, Value.RUN_DEATH, Value.RUN_CLEAR],
	Value.RETRY_DECISION: [
		Value.STAGE_LOADING, Value.BOSS_LOADING, Value.RUN_DEATH,
	],
	Value.RUN_DEATH: [Value.MAIN_MENU, Value.PREPARATION],
	Value.RUN_CLEAR: [Value.MAIN_MENU, Value.PREPARATION],
}


static func can_transition(from_phase: Value, to_phase: Value) -> bool:
	return to_phase in LEGAL_TRANSITIONS.get(from_phase, [])


static func name_of(phase: Value) -> String:
	return Value.keys()[phase].to_lower()
