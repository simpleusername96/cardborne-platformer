; Engine configuration file.
; Edit from the Godot editor when possible to preserve engine formatting.

config_version=5

[application]

config/name="Cardborne"
run/main_scene="res://scenes/main/PivotRoot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[gui]

theme/custom="res://art/ui/production/production_ui_theme.tres"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerHitbox"
2d_physics/layer_5="EnemyHitbox"
2d_physics/layer_6="Projectile"
2d_physics/layer_7="Interactable"
2d_physics/layer_8="NavigationObstacle"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
