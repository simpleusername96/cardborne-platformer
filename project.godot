; Engine configuration file.
; Edit from the Godot editor when possible to preserve engine formatting.

config_version=5

[application]

config/name="Cardborne"
run/main_scene="res://scenes/main/GameRoot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SettingsStore="*res://scripts/autoload/settings_store.gd"
VehicleGuidebookStore="*res://scripts/autoload/vehicle_guidebook_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://art/ui/production/vehicle_stage_theme.tres"

[internationalization]

locale/fallback="ko"
locale/translations=PackedStringArray("res://localization/vehicle_stage.ko.translation", "res://localization/vehicle_stage.en.translation")

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerHitbox"
2d_physics/layer_5="EnemyHitbox"
2d_physics/layer_6="Projectile"
2d_physics/layer_7="Interactable"
2d_physics/layer_8="NavigationObstacle"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_6="Projectile"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.063, 1)
