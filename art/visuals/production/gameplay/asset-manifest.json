  "integration": {
    "collision_rule": "Collision geometry, radii, live telegraphs, timing, damage, value, and state remain authoritative in gameplay code.",
    "projectile_rule": "Player primary, player seeker, and hostile non-beam projectiles use separate semantic identities; runtime owns rotation, presentation-only scale, and affinity tint.",
    "effect_rule": "effect/emp_release and effect/thermal_burst_impact are the only authored raster effects; runtime owns live-radius scale and fade, and Thermal is a direct-hit cosmetic receipt only.",
    "shared_world_cue_rule": "Fixed world surface, wall, health-frame, ring, beam, marker, disk, and crosshair identities are authored PNGs. The three approved SurfaceDetail identities are exact deterministic SVG sources. Runtime owns only placement, stretch, rotation, tint, alpha, clipping, and live-state timing.",
    "code_native_rule": "Collision geometry, topology clipping, telegraph dimensions, health and progress ratios, localized text, and live timing remain runtime truth; they do not create a second visual-identity asset."
  },
