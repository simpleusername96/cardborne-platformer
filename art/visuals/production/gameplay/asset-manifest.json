  "integration": {
    "collision_rule": "Collision geometry, radii, live telegraphs, timing, damage, value, and state remain authoritative in gameplay code.",
    "projectile_rule": "Player primary, player seeker, and hostile non-beam projectiles use separate semantic identities; runtime owns rotation, presentation-only scale, and affinity tint.",
    "effect_rule": "EMP, Thermal Burst, Drop Mine, Mystery, and boss area effects use code-native retained geometry driven by gameplay-owned centers, radii, timing, and semantic colors; no authored raster effect is indexed.",
    "shared_world_cue_rule": "Fixed world surface and wall identities remain authored PNGs. The three approved SurfaceDetail identities are exact deterministic SVG sources. Dynamic health rectangles, rings, beam corridors, disks, and simple markers are code-native geometry.",
    "code_native_rule": "Collision geometry, topology clipping, telegraph dimensions, health and progress ratios, localized text, live timing, and shape/color-only dynamic primitives remain runtime truth; they do not create a second visual-identity asset."
  },
