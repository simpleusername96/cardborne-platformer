{
  "schema_version": 1,
  "pack_id": "cardborne-semantic-v2",
  "visual_direction": "flat-color general-SF hard-surface",
  "approved_references": [
    "docs/design/component-sheets/semantic-rework-v2-proposal/13-visual-taxonomy-asis-tobe.png",
    "docs/design/component-sheets/semantic-rework-v2-proposal/14-attack-telegraph-asis-tobe.png",
    "docs/design/component-sheets/semantic-rework-v2-proposal/15-world-layering-asis-tobe.png"
  ],
  "image_contract": {
    "format": "PNG",
    "color_space": "sRGB",
    "alpha": "straight RGBA",
    "facing": "+X/right",
    "pixels_per_world_unit": 1,
    "trim_runtime_files": false,
    "texture_filter": "linear",
    "mipmaps": false,
    "repeat": false,
    "default_pivot": "canvas_center",
    "outline": "authored near-black contour",
    "source_item_limit": 3,
    "source_item_limit_note": "Animation frames count as one named effect, not separate asset identities."
  },
  "integration": {
    "requires_texture_instancing_adapter": true,
    "current_runtime_is_procedural_mesh_multimesh": true,
    "high_count_rule": "Use a texture-capable MultiMesh/atlas shader or a capped event pool; do not create one AnimatedSprite2D per projectile, enemy, or effect.",
    "collision_rule": "Collision geometry and live telegraph footprints remain authoritative and independent from these textures."
  },
  "attachments": {
    "player_hull": {
      "path": "actors/player/actor_player_hull_base.png",
      "canvas": [128, 128],
      "pivot": [64, 64],
      "rotation_driver": "hull"
    },
    "player_engine": {
      "path": "actors/player/actor_player_engine.png",
      "canvas": [64, 48],
      "pivot": [32, 24],
      "parent": "player_hull",
      "offset_world": [-42, 0],
      "rotation_driver": "hull",
      "deform_with_velocity": false,
      "note": "The engine is rigidly attached to the hull and must not bend or rotate independently while moving."
    },
    "player_aim_mount": {
      "path": "actors/player/actor_player_aim_mount.png",
      "canvas": [80, 48],
      "pivot": [40, 24],
      "parent": "player_hull",
      "offset_world": [0, 0],
      "rotation_driver": "aim"
    }
  },
