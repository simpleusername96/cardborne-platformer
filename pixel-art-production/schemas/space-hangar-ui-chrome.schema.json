{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Cardborne Space Hangar UI Chrome Candidate",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "source_family", "families", "theme_targets", "proofs"],
	"properties": {
		"schema_version": {"const": 1},
		"source_family": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "manifest", "raw", "raw_size", "chroma_key", "palette"],
			"properties": {
				"id": {"const": "space-hangar-v2-ui"},
				"manifest": {"const": "pixel-art-production/assets/source/candidates/space-hangar-v2/ui/source-manifest.json"},
				"raw": {"const": "pixel-art-production/assets/source/candidates/space-hangar-v2/ui/raw/ui-chrome-master.png"},
				"raw_size": {"const": [1024, 1024]},
				"chroma_key": {"const": "#FF00FF"},
				"palette": {
					"const": ["#141B24", "#202833", "#2E3945", "#44515E", "#596774", "#1F5FD0", "#75C4B2", "#D9A83D"]
				}
			}
		},
		"families": {
			"type": "array",
			"minItems": 5,
			"maxItems": 5,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "source_region", "outputs", "native_size", "patch_margins", "content_insets", "states"],
				"properties": {
					"id": {"enum": ["panel", "button", "card", "tab", "hud-frame"]},
					"source_region": {"$ref": "#/$defs/rect"},
					"outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+\\.png$"}},
					"native_size": {"$ref": "#/$defs/size"},
					"patch_margins": {"$ref": "#/$defs/margins"},
					"content_insets": {"$ref": "#/$defs/margins"},
					"states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
				}
			}
		},
		"theme_targets": {
			"type": "array",
			"minItems": 6,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["target", "mapping"],
				"properties": {
					"target": {"type": "string", "minLength": 1},
					"mapping": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
				}
			}
		},
		"proofs": {
			"type": "object",
			"additionalProperties": false,
			"required": ["viewports", "languages", "scale_samples", "font", "output_directory"],
			"properties": {
				"viewports": {"const": [[960, 540], [1280, 720], [1920, 1080]]},
				"languages": {"const": ["ko", "en"]},
				"scale_samples": {"const": [1.0, 1.5, 2.0]},
				"font": {"const": "art/ui/production/fonts/NotoSansKR-Variable.ttf"},
				"output_directory": {"const": "pixel-art-production/evidence/space-hangar-v2/ui/proofs"}
			}
		}
	},
	"$defs": {
		"size": {
			"type": "array",
			"prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
			"items": false
		},
		"rect": {
			"type": "array",
			"prefixItems": [
				{"type": "integer", "minimum": 0},
				{"type": "integer", "minimum": 0},
				{"type": "integer", "minimum": 1},
				{"type": "integer", "minimum": 1}
			],
			"items": false
		},
		"margins": {
			"type": "array",
			"prefixItems": [
				{"type": "integer", "minimum": 1},
				{"type": "integer", "minimum": 1},
				{"type": "integer", "minimum": 1},
				{"type": "integer", "minimum": 1}
			],
			"items": false
		}
	}
}
