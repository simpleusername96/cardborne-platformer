{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardborne.local/schemas/pixel-asset-brief.schema.json",
  "title": "Cardborne Pixel Asset Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "family",
    "approval_status",
    "gameplay_identity",
    "current_owner",
    "native_size",
    "rendered_diameter",
    "silhouette_requirement",
    "orientation_cue",
    "semantic_parts",
    "pivot",
    "anchors",
    "directions",
    "states",
    "allowed_palette_roles",
    "references",
    "avoid_rules",
    "production_method",
    "collision_reference",
    "runtime_group",
    "review_backgrounds",
    "density_tier"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "family": {
      "$ref": "#/$defs/id"
    },
    "approval_status": {
      "enum": ["proof", "candidate", "approved", "rejected"]
    },
    "gameplay_identity": {
      "type": "string",
      "minLength": 1
    },
    "current_owner": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "native_size": {
      "$ref": "#/$defs/size"
    },
    "rendered_diameter": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "silhouette_requirement": {
      "type": "string",
      "minLength": 1
    },
    "orientation_cue": {
      "type": "string",
      "minLength": 1
    },
    "semantic_parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "pivot": {
      "$ref": "#/$defs/point"
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/point"
      }
    },
    "directions": {
      "type": "integer",
      "enum": [0, 1, 2, 4, 8, 16]
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "allowed_palette_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "study"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "study": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "avoid_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "production_method": {
      "enum": ["imagegen_assisted", "direct_pixel", "derived_view"]
    },
    "collision_reference": {
      "type": "string",
      "minLength": 1
    },
    "runtime_group": {
      "$ref": "#/$defs/id"
    },
    "review_backgrounds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "density_tier": {
      "enum": ["calm", "ordinary", "hard_peak", "all"]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "integer"},
        {"type": "integer"}
      ],
      "items": false
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1, "maximum": 256},
        {"type": "integer", "minimum": 1, "maximum": 256}
      ],
      "items": false
    }
  }
}
