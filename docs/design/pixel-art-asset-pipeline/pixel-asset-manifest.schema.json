{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardborne.local/schemas/pixel-asset-manifest.schema.json",
  "title": "Cardborne Pixel Asset Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "family",
    "canvas_size",
    "logical_size",
    "palette_path",
    "semantic_palette_path",
    "transparent_color",
    "layers",
    "pivot",
    "anchors",
    "frames",
    "atlas"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "canvas_size": {
      "type": "integer",
      "minimum": 64,
      "maximum": 2048
    },
    "logical_size": {
      "$ref": "#/$defs/size"
    },
    "palette_path": {
      "type": "string",
      "minLength": 1
    },
    "semantic_palette_path": {
      "type": "string",
      "minLength": 1
    },
    "transparent_color": {
      "$ref": "#/$defs/color"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mask_color", "z", "required"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "mask_color": {
            "$ref": "#/$defs/color"
          },
          "z": {
            "type": "integer"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "pivot": {
      "$ref": "#/$defs/point"
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/point"
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_path", "semantic_mask_path", "atlas_index"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "semantic_mask_path": {
            "type": "string",
            "minLength": 1
          },
          "atlas_index": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "state": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "padding"],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "integer"},
        {"type": "integer"}
      ],
      "items": false
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1, "maximum": 256},
        {"type": "integer", "minimum": 1, "maximum": 256}
      ],
      "items": false
    }
  }
}
