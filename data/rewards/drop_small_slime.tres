[gd_resource type="Resource" script_class="RewardTable" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/progression/RewardTable.gd" id="1"]
[ext_resource type="Script" path="res://scripts/progression/RewardEntry.gd" id="2"]

[sub_resource type="Resource" id="XP"]
