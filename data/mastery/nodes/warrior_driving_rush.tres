[gd_resource type="Resource" script_class="MasteryNodeDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/progression/MasteryNodeDefinition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/progression/ProgressionBehaviorEffect.gd" id="2"]

[sub_resource type="Resource" id="CarryTargets"]
script = ExtResource("2")
effect_type = &"shield_rush_carries_light_targets"
source_id = &"warrior_driving_rush"
source_scope = "mastery"

[sub_resource type="Resource" id="WallStagger"]
script = ExtResource("2")
effect_type = &"wall_impact_stagger"
source_id = &"warrior_driving_rush"
source_scope = "mastery"
stagger = 20

[resource]
script = ExtResource("1")
id = &"warrior_driving_rush"
display_name = "Driving Rush"
mechanical_description = "Shield Rush carries light enemies to its endpoint; wall impact adds 20 stagger."
content_version = 1
character_id = &"warrior"
depth = &"root"
costs = {
"rusted_scrap": 4
}
behavior_effects = Array[ExtResource("2")]([SubResource("CarryTargets"), SubResource("WallStagger")])
