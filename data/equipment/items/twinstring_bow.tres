[gd_resource type="Resource" script_class="EquipmentDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/progression/EquipmentDefinition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/progression/ProgressionBehaviorEffect.gd" id="2"]

[sub_resource type="Resource" id="QuickShotRepeat"]
script = ExtResource("2")
effect_type = &"quick_shot_repeat"
source_id = &"twinstring_bow"
source_scope = "equipment"
target_id = &"archer_quick_shot"
delay = 0.16
damage_scale = 0.5

[sub_resource type="Resource" id="PowerShotPenalty"]
script = ExtResource("2")
effect_type = &"power_shot_max_damage"
source_id = &"twinstring_bow"
source_scope = "equipment"
target_id = &"archer_power_shot"
damage_delta = -1

[resource]
script = ExtResource("1")
id = &"twinstring_bow"
display_name = "Twinstring Bow"
mechanical_description = "Quick Shot repeats at 50 percent damage after 0.16 seconds."
tradeoff_description = "Power Shot maximum damage is reduced by 1."
content_version = 1
slot = &"weapon"
compatibility = Array[StringName]([&"archer"])
source = &"high_route_cache"
behavior_effects = Array[ExtResource("2")]([SubResource("QuickShotRepeat"), SubResource("PowerShotPenalty")])
salvage_materials = {
"sky_thread": 4
}
unlock_costs = {
"sky_thread": 6
}
