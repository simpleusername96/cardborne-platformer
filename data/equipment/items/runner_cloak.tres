[gd_resource type="Resource" script_class="EquipmentDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/progression/EquipmentDefinition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/player/EffectDefinition.gd" id="2"]
[ext_resource type="Script" path="res://scripts/progression/ProgressionBehaviorEffect.gd" id="3"]

[sub_resource type="Resource" id="MoveSpeed"]
script = ExtResource("2")
stat_id = &"move_speed"
operation = "add"
value = 16.0
source_id = &"runner_cloak"
source_scope = "equipment"

[sub_resource type="Resource" id="DashCooldown"]
script = ExtResource("2")
stat_id = &"dash_cooldown"
operation = "add"
value = -0.03
source_id = &"runner_cloak"
source_scope = "equipment"

[sub_resource type="Resource" id="HealthPenalty"]
script = ExtResource("2")
stat_id = &"max_health"
operation = "add"
value = -1.0
source_id = &"runner_cloak"
source_scope = "equipment"

[sub_resource type="Resource" id="MinimumHealth"]
script = ExtResource("3")
effect_type = &"minimum_stat_value"
source_id = &"runner_cloak"
source_scope = "equipment"
target_id = &"max_health"
value = 3.0

[resource]
script = ExtResource("1")
id = &"runner_cloak"
display_name = "Runner Cloak"
mechanical_description = "Adds 16 move speed and reduces dash cooldown by 0.03 seconds."
tradeoff_description = "Maximum health is reduced by 1 but cannot fall below 3."
content_version = 1
slot = &"armor"
compatibility = Array[StringName]([&"shared"])
source = &"high_route_reward"
build_effects = Array[ExtResource("2")]([SubResource("MoveSpeed"), SubResource("DashCooldown"), SubResource("HealthPenalty")])
behavior_effects = Array[ExtResource("3")]([SubResource("MinimumHealth")])
salvage_materials = {
"sky_thread": 3
}
unlock_costs = {
"sky_thread": 5
}
