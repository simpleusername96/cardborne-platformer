[ext_resource type="Script" path="res://scripts/progression/ProgressionBehaviorEffect.gd" id="2"]

[sub_resource type="Resource" id="EncounterGuard"]
script = ExtResource("2")
effect_type = &"full_health_encounter_clear_guard"
source_id = &"slime_relic"
source_scope = "equipment"
duration = 20.0
limit = &"once_per_stage"

[resource]
script = ExtResource("1")
id = &"slime_relic"
display_name = "Slime Relic"
mechanical_description = "Clearing an encounter at full health grants a one-hit guard for 20 seconds."
tradeoff_description = "Triggers once per stage and expires on room exit."
content_version = 1
slot = &"relic"
compatibility = Array[StringName]([&"shared"])
source = &"boss_core_unlock"
behavior_effects = Array[ExtResource("2")]([SubResource("EncounterGuard")])
