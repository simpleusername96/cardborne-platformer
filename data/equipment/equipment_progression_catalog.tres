[resource]
script = ExtResource("1_catalog")
id = &"minimum_equipment_progression"
display_name = "Minimum Equipment Progression"
content_version = 1
tags = Array[StringName]([&"equipment_progression_catalog", &"minimum_slice"])
materials = Array[ExtResource("2_material_script")]([ExtResource("6_rusted_scrap"), ExtResource("7_steel_fragment"), ExtResource("8_common_timber"), ExtResource("9_hardwood"), ExtResource("10_sky_thread"), ExtResource("11_reinforced_fabric")])
models = Array[ExtResource("3_model_script")]([ExtResource("12_traveler_sword"), ExtResource("13_hunting_spear"), ExtResource("14_hunting_bow"), ExtResource("15_matchlock"), ExtResource("16_round_shield"), ExtResource("17_tower_shield"), ExtResource("18_traveler_coat"), ExtResource("19_reinforced_coat")])
blueprints = Array[ExtResource("4_blueprint_script")]([ExtResource("20_traveler_sword_blueprint"), ExtResource("21_hunting_spear_blueprint"), ExtResource("22_hunting_bow_blueprint"), ExtResource("23_matchlock_blueprint"), ExtResource("24_round_shield_blueprint"), ExtResource("25_tower_shield_blueprint"), ExtResource("26_traveler_coat_blueprint"), ExtResource("27_reinforced_coat_blueprint")])
spirit_stones = Array[ExtResource("5_stone_script")]([ExtResource("28_ember_stone"), ExtResource("29_frost_stone")])
