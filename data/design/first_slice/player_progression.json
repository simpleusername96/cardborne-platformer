{
  "schema": "cardborne.first_slice.player_progression.v0",
  "notes": [
    "Seed design data only. Player code should read effective stats after all sources are combined.",
    "Run levels use economy_tables.run_level_curve; this file owns controls, base stats, micro-upgrade choices, and skill branch examples."
  ],
  "growth_source_contract": [
    {
      "id": "xp_level",
      "data_owner": "economy_tables.run_level_curve + player_progression.micro_upgrade_pool",
      "reset_behavior": "run",
      "implementation_limit": "Offer a small level-up choice; do not build a full permanent skill tree UI first."
    },
    {
      "id": "card",
      "data_owner": "card_catalog.cards",
      "reset_behavior": "run",
      "implementation_limit": "Stage-clear and boss-clear reward choices only."
    },
    {
      "id": "coin_purchase",
      "data_owner": "economy_tables.shop_seed",
      "reset_behavior": "run",
      "implementation_limit": "Optional shop/rest purchases; no online economy."
    },
    {
      "id": "material_upgrade",
      "data_owner": "skill_branches persistent_candidate nodes",
      "reset_behavior": "profile_candidate",
      "implementation_limit": "Collect and display first; persistence can wait for a lightweight local profile."
    },
    {
      "id": "equipment",
      "data_owner": "equipment_catalog.items",
      "reset_behavior": "implementation_defined",
      "implementation_limit": "Simple equipped slot IDs; no grid inventory."
    }
  ],
