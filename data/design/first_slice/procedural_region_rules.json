{
  "schema": "cardborne.first_run.stage_generation.v1",
  "generation_model": {
    "method": "authored_room_template_assembly",
    "max_retries": 3,
    "fallback_required": true,
    "rng_streams": ["room_graph", "room_variant", "encounter", "hazard", "reward"]
  },
  "movement_constraints": {
    "source": "MovementMetrics.route_limits_for_profiles",
    "ordinary_gap_ratio": 0.65,
    "ordinary_ledge_ratio": 0.72,
    "critical_landing_width": 220,
    "optional_landing_width": 180,
    "critical_approach_width": 180,
    "dash_approach_width": 260,
    "standing_headroom_margin": 20,
    "crouch_headroom_margin": 12,
    "safe_entry_width": 240
  },
  "stage_profiles": [
    {
      "id": "ruin_approach",
      "required_room_count": 6,
      "optional_branch_count": [1, 1],
      "required_roles": ["start", "traversal", "combat", "choice", "combat", "exit"],
      "terminal_room_role": "exit",
      "eligible_enemies": ["walker", "charger", "shooter"],
      "eligible_hazards": ["spike_row", "fall_reset"],
      "encounter_budget_per_room": [1, 3],
      "hazard_budget_per_room": [0, 1],
      "fallback_id": "fallback_ruin_approach_v1"
    },
    {
      "id": "flooded_works",
      "required_room_count": 7,
      "optional_branch_count": [1, 2],
      "required_roles": ["start", "traversal", "hazard", "combat", "choice", "combat", "safe"],
      "terminal_room_role": "safe",
      "eligible_enemies": ["walker", "charger", "shooter", "leaper"],
      "eligible_hazards": ["spike_row", "fall_reset", "timed_poison_vent", "crumbling_platform"],
      "encounter_budget_per_room": [2, 5],
      "hazard_budget_per_room": [0, 2],
      "fallback_id": "fallback_flooded_works_v1"
    },
    {
      "id": "broken_sanctum",
      "required_room_count": 8,
      "optional_branch_count": [2, 2],
      "required_roles": ["start", "combat", "objective", "hazard", "choice", "combat", "combat", "exit"],
      "terminal_room_role": "exit",
      "eligible_enemies": ["walker", "charger", "shooter", "shield_guard", "leaper", "sentry", "summon_node"],
      "eligible_hazards": ["spike_row", "fall_reset", "timed_poison_vent", "crumbling_platform"],
      "encounter_budget_per_room": [4, 7],
      "hazard_budget_per_room": [1, 2],
      "fallback_id": "fallback_broken_sanctum_v1"
    }
  ],
  "room_templates": [
    { "id": "lr_start_shelf", "role": "start", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "required_anchors": ["player_spawn", "camera", "critical_exit", "recovery"] },
    { "id": "lr_rise_steps", "role": "traversal", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "terrain": ["mass_seam", "rise_steps"] },
    { "id": "lr_lower_upper_choice", "role": "choice", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "required_anchors": ["branch", "rejoin", "reward", "lower_recovery"] },
    { "id": "lr_rope_shaft", "role": "traversal", "stages": ["ruin_approach", "flooded_works"], "terrain": ["rope_shaft"], "required_anchors": ["rope", "lower_recovery", "top_exit"] },
    { "id": "lr_broken_bridge", "role": "traversal", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "terrain": ["safe_gap", "drop_basin"], "required_anchors": ["jump_approach", "jump_landing", "recovery"] },
    { "id": "lr_patrol_gallery", "role": "combat", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "enemy_tags": ["occupier"], "required_anchors": ["safe_entry", "enemy_ground", "clear_gate"] },
    { "id": "lr_charge_lane", "role": "combat", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "enemy_tags": ["burst"], "required_anchors": ["charge_lane", "escape_pad", "clear_gate"] },
    { "id": "lr_shooter_overlook", "role": "combat", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "enemy_tags": ["ranged"], "required_anchors": ["ranged_perch", "cover", "ground_enemy"] },
    { "id": "lr_shield_choke", "role": "combat", "stages": ["broken_sanctum"], "enemy_tags": ["guard"], "required_anchors": ["guard", "flank_route", "clear_exit"] },
    { "id": "lr_leaper_basin", "role": "combat", "stages": ["flooded_works", "broken_sanctum"], "enemy_tags": ["vertical"], "required_anchors": ["leap_lane", "arc_clearance", "side_recovery"] },
    { "id": "lr_poison_timing", "role": "hazard", "stages": ["flooded_works", "broken_sanctum"], "hazard_tags": ["timed_poison_vent"], "required_anchors": ["vent_group", "permanent_safe_zone"] },
    { "id": "lr_crumble_crossing", "role": "hazard", "stages": ["flooded_works", "broken_sanctum"], "hazard_tags": ["crumbling_platform"], "required_anchors": ["wait_pad", "crumble_path", "lower_recovery"] },
    { "id": "lr_gate_switch_loop", "role": "objective", "stages": ["flooded_works", "broken_sanctum"], "required_anchors": ["switch", "gate", "return_path"] },
    { "id": "lr_destructible_cache", "role": "optional", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "required_anchors": ["destructible", "cache_reward", "rejoin"] },
    { "id": "lr_material_cavern", "role": "optional", "stages": ["ruin_approach", "flooded_works", "broken_sanctum"], "required_anchors": ["material_node", "branch", "rejoin", "recovery"] },
    { "id": "lr_rest_forge", "role": "safe", "stages": ["flooded_works"], "required_anchors": ["rest_spawn", "forge", "shop", "exit"], "forbidden_tags": ["enemy", "hazard"] },
    { "id": "lr_sentry_crossfire", "role": "combat", "stages": ["broken_sanctum"], "enemy_tags": ["ranged", "zone"], "required_anchors": ["sentry", "cover", "safe_entry", "clear_gate"] },
    { "id": "lr_exit_ascent", "role": "exit", "stages": ["ruin_approach", "broken_sanctum"], "required_anchors": ["checkpoint", "final_encounter", "exit_portal"] }
  ],
  "graph_rules": [
    "one_start_one_exit",
    "all_required_objectives_on_reachable_critical_path",
    "optional_branches_rejoin_before_exit",
    "no_adjacent_same_primary_enemy_lesson",
    "new_hazard_taught_before_mixed_pressure",
    "safe_room_not_first_last_or_adjacent_to_safe_room",
    "final_encounter_uses_only_previously_taught_pressure"
  ],
  "validation_rules": [
    "schema_and_cross_references",
    "graph_reachability_and_objective_order",
    "socket_direction_opening_and_support_delta",
    "collision_path_and_visual_support_agreement",
    "movement_envelope_landings_headroom_crouch_climb",
    "fall_recovery_and_checkpoint_safety",
    "enemy_hazard_support_clearance_response_space_caps",
    "safe_entry_switch_reward_and_exit_clearance",
    "camera_commitment_visibility",
    "encounter_hazard_reward_and_duration_budgets"
  ]
}
