{
  "schema": "cardborne.first_slice.economy_tables.v0",
  "notes": [
    "Seed design data only. Balance values are placeholders for first playable implementation.",
    "XP and coins are run-local. Materials may be held in run state first and only persist once a lightweight local profile exists.",
    "Reward IDs are intentionally stable so enemies, gimmicks, and stages can reference them without duplicating reward quantities."
  ],
  "currencies": [
    {
      "id": "xp",
      "display_name": "XP",
      "scope": "run",
      "reset_behavior": "resets_on_new_run",
      "purpose": "Advance run level and trigger micro-upgrade choices."
    },
    {
      "id": "coin",
      "display_name": "Coin",
      "scope": "run",
      "reset_behavior": "resets_on_new_run",
      "purpose": "Buy healing, card rerolls, temporary upgrades, or shop items during the current run."
    },
    {
      "id": "slime_residue",
      "display_name": "Slime Residue",
      "scope": "material",
      "reset_behavior": "run_local_until_profile_persistence_exists",
      "purpose": "Common upgrade/crafting material from slime enemies and boss-related content."
    },
    {
      "id": "rusted_scrap",
      "display_name": "Rusted Scrap",
      "scope": "material",
      "reset_behavior": "run_local_until_profile_persistence_exists",
      "purpose": "Material from ruin objects, chests, and armored hazards."
    },
    {
      "id": "sky_thread",
      "display_name": "Sky Thread",
      "scope": "material",
      "reset_behavior": "run_local_until_profile_persistence_exists",
      "purpose": "Mobility-themed material from high-route rewards and moving-platform challenges."
    },
    {
      "id": "boss_core",
      "display_name": "Boss Core",
      "scope": "material",
      "reset_behavior": "profile_candidate_after_boss_clear",
      "purpose": "Rare boss material used for later weapon, relic, or permanent upgrade unlocks."
    }
  ],
