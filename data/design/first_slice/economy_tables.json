{
  "schema": "cardborne.first_run.economy.v1",
  "transaction_rules": {
    "id_parts": ["run_seed", "stage_index", "room_id", "source_anchor", "sequence"],
    "idempotent": true,
    "common_materials_persist_on_death": true,
    "equipment_unlocks_persist_on_pickup": true,
    "boss_core_requires_victory": true
  },
  "currencies": [
    { "id": "xp", "scope": "run", "sink": "run_level" },
    { "id": "coin", "scope": "run", "sink": "heal_reroll_consumable_forge" },
    { "id": "rusted_scrap", "scope": "profile", "sink": "warrior_and_shared_unlocks" },
    { "id": "sky_thread", "scope": "profile", "sink": "archer_and_mobility_unlocks" },
    { "id": "slime_residue", "scope": "profile", "sink": "assassin_and_survival_unlocks" },
    { "id": "boss_core", "scope": "profile", "sink": "capstones_and_slime_relic" }
  ],
  "run_level_curve": [
    { "level": 1, "xp_total": 0 },
    { "level": 2, "xp_total": 20 },
    { "level": 3, "xp_total": 55 },
    { "level": 4, "xp_total": 105 },
    { "level": 5, "xp_total": 170 },
    { "level": 6, "xp_total": 250 }
  ],
  "drop_tables": [
    { "id": "drop_walker", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 6 }], "rolls": [{ "type": "currency", "id": "coin", "min": 1, "max": 3, "chance": 0.85 }, { "type": "currency", "id": "rusted_scrap", "amount": 1, "chance": 0.15 }] },
    { "id": "drop_charger", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 12 }, { "type": "currency", "id": "coin", "amount": 3 }], "rolls": [{ "type": "currency", "id": "rusted_scrap", "min": 1, "max": 2, "chance": 0.35 }] },
    { "id": "drop_shooter", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 10 }, { "type": "currency", "id": "coin", "amount": 2 }], "rolls": [{ "type": "currency", "id": "sky_thread", "amount": 1, "chance": 0.2 }] },
    { "id": "drop_shield_guard", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 18 }, { "type": "currency", "id": "coin", "amount": 4 }], "rolls": [{ "type": "currency", "id": "rusted_scrap", "min": 1, "max": 2, "chance": 0.55 }] },
    { "id": "drop_leaper", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 12 }, { "type": "currency", "id": "coin", "amount": 2 }], "rolls": [{ "type": "currency", "id": "sky_thread", "amount": 1, "chance": 0.25 }, { "type": "currency", "id": "slime_residue", "amount": 1, "chance": 0.2 }] },
    { "id": "drop_sentry", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 20 }, { "type": "currency", "id": "coin", "amount": 5 }, { "type": "currency", "id": "rusted_scrap", "amount": 1 }], "rolls": [{ "type": "item_pool", "id": "compatible_non_boss_equipment", "chance": 0.1 }] },
    { "id": "drop_summon_node", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 20 }, { "type": "currency", "id": "coin", "amount": 4 }], "rolls": [{ "type": "currency", "id": "slime_residue", "min": 1, "max": 2, "chance": 0.5 }] },
    { "id": "drop_small_slime", "guaranteed": [{ "type": "currency", "id": "xp", "amount": 4 }], "rolls": [{ "type": "currency", "id": "coin", "min": 1, "max": 2, "chance": 0.6 }, { "type": "currency", "id": "slime_residue", "amount": 1, "chance": 0.25 }] },
    { "id": "drop_material_node", "guaranteed": [{ "type": "currency", "id": "coin", "amount": 2 }], "rolls": [{ "type": "currency", "id": "rusted_scrap", "min": 1, "max": 2, "chance": 0.55 }, { "type": "currency", "id": "sky_thread", "amount": 1, "chance": 0.25 }, { "type": "currency", "id": "slime_residue", "amount": 1, "chance": 0.2 }] },
    { "id": "drop_slime_king", "guaranteed": [{ "type": "currency", "id": "slime_residue", "amount": 8 }, { "type": "currency", "id": "boss_core", "amount": 1 }], "rolls": [] }
  ],
  "stage_clear_rewards": [
    { "stage_profile": "ruin_approach", "rewards": [{ "type": "currency", "id": "xp", "amount": 12 }, { "type": "currency", "id": "coin", "amount": 8 }, { "type": "card_choice", "count": 3 }] },
    { "stage_profile": "flooded_works", "rewards": [{ "type": "currency", "id": "xp", "amount": 18 }, { "type": "currency", "id": "coin", "amount": 12 }, { "type": "currency", "id": "rusted_scrap", "amount": 1 }, { "type": "card_choice", "count": 3 }, { "type": "rest_forge_access" }] },
    { "stage_profile": "broken_sanctum", "rewards": [{ "type": "currency", "id": "xp", "amount": 24 }, { "type": "currency", "id": "coin", "amount": 16 }, { "type": "currency", "id": "sky_thread", "amount": 1 }, { "type": "card_choice", "count": 3 }] },
    { "stage_profile": "slime_court", "rewards": [{ "type": "apply_drop_table", "id": "drop_slime_king" }, { "type": "run_clear" }] }
  ],
  "shop": [
    { "id": "shop_heal_small", "coin_cost": 8, "effect": { "type": "heal_now", "value": 2 } },
    { "id": "shop_card_reroll", "coin_cost": 12, "effect": { "type": "reroll_current_card_offer" } },
    { "id": "shop_forge", "coin_cost": 15, "effect": { "type": "open_forge_choice", "choices": 3 } },
    { "id": "shop_small_potion", "coin_cost": 8, "effect": { "type": "grant_consumable", "id": "small_potion" } },
    { "id": "shop_dash_tonic", "coin_cost": 10, "effect": { "type": "grant_consumable", "id": "dash_tonic" } },
    { "id": "shop_salvage_kit", "coin_cost": 10, "effect": { "type": "grant_consumable", "id": "salvage_kit" } }
  ],
  "balance_targets": [
    { "checkpoint": "end_stage_1", "coin_min": 18, "coin_max": 28 },
    { "checkpoint": "stage_2_rest", "coin_min": 38, "coin_max": 58 },
    { "checkpoint": "end_stage_3", "coin_min": 65, "coin_max": 95 }
  ]
}
