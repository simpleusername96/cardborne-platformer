[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/lower_ruins/LrDestructibleCache.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomRewardAnchorData.gd" id="4"]

[sub_resource type="Resource" id="BranchSocket"]
script = ExtResource("2")
id = &"cache_branch"
direction = &"up"
route_role = &"optional"
local_position = Vector2(56, 0)
opening_size = Vector2(112, 120)
support_top = 620.0
transition_type = &"drop"
required_ability = &"baseline"
approach_width = 260.0
landing_width = 260.0
headroom = 120.0
recovery_id = &"CacheRecovery"

[sub_resource type="Resource" id="RejoinSocket"]
script = ExtResource("2")
id = &"cache_rejoin"
direction = &"up"
route_role = &"return"
local_position = Vector2(1064, 0)
opening_size = Vector2(112, 120)
support_top = 620.0
transition_type = &"rope"
required_ability = &"climb"
approach_width = 220.0
landing_width = 220.0
headroom = 120.0
recovery_id = &"CacheRecovery"

[sub_resource type="Resource" id="RewardAnchorCache"]
script = ExtResource("4")
id = &"cache_reward"
reward_role = &"cache_reward"
eligible_table_ids = Array[StringName]([&"cache_matchlock"])
risk_tier = 1
interaction_space = Vector2(140, 100)
budget_cost = 1

[resource]
script = ExtResource("1")
id = &"lr_destructible_cache"
display_name = "Destructible Cache"
content_version = 3
scene = ExtResource("3")
role = &"optional"
stage_tags = Array[StringName]([&"ruin_approach"])
required_route = false
bounds = Rect2(0, 0, 1120, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("BranchSocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("RejoinSocket")])
encounter_budget = Vector2i(0, 0)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(1, 1)
reward_anchors = Array[ExtResource("4")]([SubResource("RewardAnchorCache")])
recovery_anchor_ids = Array[StringName]([&"cache_recovery"])
estimated_seconds = Vector2i(15, 30)
