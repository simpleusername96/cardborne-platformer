[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/lower_ruins/LrLowerUpperChoice.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomEnemyAnchorData.gd" id="4"]
[ext_resource type="Script" path="res://scripts/stages/RoomRewardAnchorData.gd" id="5"]

[sub_resource type="Resource" id="EntrySocket"]
script = ExtResource("2")
id = &"choice_entry"
direction = &"left"
route_role = &"critical"
local_position = Vector2(0, 620)
opening_size = Vector2(160, 140)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 260.0
landing_width = 260.0
headroom = 140.0

[sub_resource type="Resource" id="RejoinSocket"]
script = ExtResource("2")
id = &"choice_optional_rejoin"
direction = &"down"
route_role = &"return"
local_position = Vector2(1064, 720)
opening_size = Vector2(112, 120)
support_top = 620.0
transition_type = &"rope"
required_ability = &"climb"
approach_width = 220.0
landing_width = 220.0
headroom = 120.0
recovery_id = &"LowerRecovery"

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"choice_exit"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1120, 620)
opening_size = Vector2(160, 140)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 260.0
landing_width = 260.0
headroom = 140.0

[sub_resource type="Resource" id="BranchSocket"]
script = ExtResource("2")
id = &"choice_optional_branch"
direction = &"down"
route_role = &"optional"
local_position = Vector2(56, 720)
opening_size = Vector2(112, 120)
support_top = 620.0
transition_type = &"drop"
required_ability = &"baseline"
approach_width = 220.0
landing_width = 260.0
headroom = 120.0
recovery_id = &"LowerRecovery"

[sub_resource type="Resource" id="EnemyAnchorGroundOccupier"]
script = ExtResource("4")
id = &"ground_occupier"
allowed_pressure_roles = Array[StringName]([&"occupier"])
support_width = 260.0
lane_width = 220.0
clearance = 180.0
has_escape_route = false
has_line_of_sight = false
has_cover_or_elevation = false

[sub_resource type="Resource" id="RewardAnchorUpper"]
script = ExtResource("5")
id = &"upper_reward"
reward_role = &"spirit_shrine"
eligible_table_ids = Array[StringName]([&"shrine_frost_spirit"])
risk_tier = 1
interaction_space = Vector2(120, 96)
budget_cost = 1

[resource]
script = ExtResource("1")
id = &"lr_lower_upper_choice"
display_name = "Lower / Upper Choice"
content_version = 3
scene = ExtResource("3")
role = &"choice"
stage_tags = Array[StringName]([&"ruin_approach"])
required_route = true
bounds = Rect2(0, 0, 1120, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket"), SubResource("RejoinSocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket"), SubResource("BranchSocket")])
encounter_budget = Vector2i(0, 1)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(1, 1)
allowed_enemy_tags = Array[StringName]([&"occupier"])
enemy_anchors = Array[ExtResource("4")]([SubResource("EnemyAnchorGroundOccupier")])
reward_anchors = Array[ExtResource("5")]([SubResource("RewardAnchorUpper")])
recovery_anchor_ids = Array[StringName]([&"lower_recovery"])
estimated_seconds = Vector2i(25, 45)
