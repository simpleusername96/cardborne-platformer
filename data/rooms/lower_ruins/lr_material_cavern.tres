[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/lower_ruins/LrMaterialCavern.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomEnemyAnchorData.gd" id="4"]
[ext_resource type="Script" path="res://scripts/stages/RoomRewardAnchorData.gd" id="5"]

[sub_resource type="Resource" id="BranchSocket"]
script = ExtResource("2")
id = &"cavern_branch"
direction = &"up"
route_role = &"optional"
local_position = Vector2(56, 0)
opening_size = Vector2(112, 120)
support_top = 520.0
transition_type = &"drop"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 540.0
headroom = 120.0
recovery_id = &"CavernRecovery"

[sub_resource type="Resource" id="RejoinSocket"]
script = ExtResource("2")
id = &"cavern_rejoin"
direction = &"up"
route_role = &"return"
local_position = Vector2(1064, 0)
opening_size = Vector2(112, 120)
support_top = 520.0
transition_type = &"rope"
required_ability = &"climb"
approach_width = 280.0
landing_width = 280.0
headroom = 120.0
recovery_id = &"CavernRecovery"

[sub_resource type="Resource" id="EnemyAnchorBasinOccupier"]
script = ExtResource("4")
id = &"basin_occupier"
allowed_pressure_roles = Array[StringName]([&"occupier"])
support_width = 260.0
lane_width = 220.0
clearance = 180.0
has_escape_route = false
has_line_of_sight = false
has_cover_or_elevation = false

[sub_resource type="Resource" id="RewardAnchorMaterial"]
script = ExtResource("5")
id = &"material_node"
reward_role = &"material_node"
eligible_table_ids = Array[StringName]([&"material_cavern_ruin"])
risk_tier = 1
interaction_space = Vector2(140, 100)
budget_cost = 1

[resource]
script = ExtResource("1")
id = &"lr_material_cavern"
display_name = "Material Cavern"
content_version = 1
scene = ExtResource("3")
role = &"optional"
stage_tags = Array[StringName]([&"ruin_approach"])
required_route = false
bounds = Rect2(0, 0, 1120, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("BranchSocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("RejoinSocket")])
encounter_budget = Vector2i(0, 1)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(1, 1)
allowed_enemy_tags = Array[StringName]([&"occupier"])
enemy_anchors = Array[ExtResource("4")]([SubResource("EnemyAnchorBasinOccupier")])
reward_anchors = Array[ExtResource("5")]([SubResource("RewardAnchorMaterial")])
recovery_anchor_ids = Array[StringName]([&"cavern_recovery"])
estimated_seconds = Vector2i(20, 40)
