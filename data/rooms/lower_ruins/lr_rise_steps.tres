[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/lower_ruins/LrRiseSteps.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomHazardAnchorData.gd" id="4"]

[sub_resource type="Resource" id="EntrySocket"]
script = ExtResource("2")
id = &"rise_entry"
direction = &"left"
route_role = &"critical"
local_position = Vector2(0, 620)
opening_size = Vector2(160, 140)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 260.0
landing_width = 360.0
headroom = 140.0

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"rise_exit"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1120, 412)
opening_size = Vector2(160, 160)
support_top = 412.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 300.0
headroom = 160.0

[sub_resource type="Resource" id="HazardAnchorSpikeRow"]
script = ExtResource("4")
id = &"spike_row_a"
allowed_hazard_ids = Array[StringName]([&"spike_row"])
warning_space = Vector2(180, 120)
safe_zone_id = &"middle_landing"

[resource]
script = ExtResource("1")
id = &"lr_rise_steps"
display_name = "Rise Steps"
content_version = 3
scene = ExtResource("3")
role = &"traversal"
stage_tags = Array[StringName]([&"ruin_approach"])
required_route = true
bounds = Rect2(0, 0, 1120, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(0, 0)
hazard_budget = Vector2i(0, 1)
reward_budget = Vector2i(0, 0)
hazard_anchors = Array[ExtResource("4")]([SubResource("HazardAnchorSpikeRow")])
recovery_anchor_ids = Array[StringName]([&"lower_landing", &"middle_landing", &"upper_landing"])
estimated_seconds = Vector2i(15, 30)
