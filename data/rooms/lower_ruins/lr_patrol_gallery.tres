has_escape_route = false
has_line_of_sight = false
has_cover_or_elevation = false

[sub_resource type="Resource" id="EnemyAnchorPerchShooter"]
script = ExtResource("4")
id = &"perch_shooter"
allowed_pressure_roles = Array[StringName]([&"ranged"])
support_width = 220.0
lane_width = 180.0
