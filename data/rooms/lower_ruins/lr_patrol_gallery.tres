[sub_resource type="Resource" id="RewardAnchorNpc"]
script = ExtResource("5")
id = &"npc_reward"
reward_role = &"npc_reward"
eligible_table_ids = Array[StringName]([&"npc_hunting_spear"])
risk_tier = 0
interaction_space = Vector2(140, 110)
budget_cost = 1

[resource]
script = ExtResource("1")
id = &"lr_patrol_gallery"
display_name = "Patrol Gallery"
content_version = 5
scene = ExtResource("3")
role = &"combat"
stage_tags = Array[StringName]([&"ruin_approach"])
required_route = true
bounds = Rect2(0, 0, 1120, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(1, 4)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(1, 1)
allowed_enemy_tags = Array[StringName]([&"occupier", &"ranged"])
enemy_anchors = Array[ExtResource("4")]([SubResource("EnemyAnchorWalkerA"), SubResource("EnemyAnchorWalkerB"), SubResource("EnemyAnchorPerchShooter")])
reward_anchors = Array[ExtResource("5")]([SubResource("RewardAnchorNpc")])
recovery_anchor_ids = Array[StringName]([&"ground_recovery"])
estimated_seconds = Vector2i(20, 40)
variant_group = &"patrol_gallery_m1"
