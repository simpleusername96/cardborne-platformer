[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/lower_ruins/LrExitAscent.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomEnemyAnchorData.gd" id="4"]

[sub_resource type="Resource" id="EntrySocket"]
script = ExtResource("2")
id = &"exit_ascent_entry"
direction = &"left"
route_role = &"critical"
local_position = Vector2(0, 650)
opening_size = Vector2(180, 160)
support_top = 650.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 300.0
headroom = 160.0

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"exit_ascent_exit"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1120, 458)
opening_size = Vector2(180, 180)
support_top = 458.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 300.0
headroom = 180.0

[sub_resource type="Resource" id="EnemyAnchorWalkerA"]
script = ExtResource("4")
id = &"walker_a"
allowed_pressure_roles = Array[StringName]([&"occupier"])
support_width = 260.0
lane_width = 200.0
clearance = 180.0
has_escape_route = false
has_line_of_sight = false
has_cover_or_elevation = false

[sub_resource type="Resource" id="EnemyAnchorWalkerB"]
script = ExtResource("4")
id = &"walker_b"
allowed_pressure_roles = Array[StringName]([&"occupier"])
support_width = 260.0
lane_width = 200.0
clearance = 180.0
has_escape_route = false
has_line_of_sight = false
has_cover_or_elevation = false

[resource]
script = ExtResource("1")
id = &"lr_exit_ascent"
display_name = "Exit Ascent"
content_version = 5
scene = ExtResource("3")
role = &"exit"
stage_tags = Array[StringName]([&"ruin_approach"])
required_route = true
bounds = Rect2(0, 0, 1120, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(2, 2)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
allowed_enemy_tags = Array[StringName]([&"occupier"])
enemy_anchors = Array[ExtResource("4")]([SubResource("EnemyAnchorWalkerA"), SubResource("EnemyAnchorWalkerB")])
recovery_anchor_ids = Array[StringName]([&"entry_recovery", &"ascent_recovery"])
estimated_seconds = Vector2i(30, 55)
