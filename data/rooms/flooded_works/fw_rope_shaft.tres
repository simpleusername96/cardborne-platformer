has_line_of_sight = false
has_cover_or_elevation = true

[sub_resource type="Resource" id="UpperShooter"]
script = ExtResource("4")
id = &"shaft_upper_shooter"
allowed_pressure_roles = Array[StringName]([&"ranged"])
support_width = 220.0
lane_width = 180.0
clearance = 260.0
has_escape_route = true
has_line_of_sight = true
has_cover_or_elevation = true

[resource]
script = ExtResource("1")
id = &"fw_rope_shaft"
display_name = "Flooded Rope Shaft"
content_version = 3
scene = ExtResource("3")
role = &"combat"
stage_tags = Array[StringName]([&"flooded_works"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(5, 5)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
allowed_enemy_tags = Array[StringName]([&"occupier", &"vertical", &"ranged"])
enemy_anchors = Array[ExtResource("4")]([SubResource("LowerOccupier"), SubResource("MidLeaper"), SubResource("UpperShooter")])
recovery_anchor_ids = Array[StringName]([&"shaft_entry_recovery", &"shaft_lower_recovery", &"shaft_exit_recovery"])
estimated_seconds = Vector2i(20, 35)
