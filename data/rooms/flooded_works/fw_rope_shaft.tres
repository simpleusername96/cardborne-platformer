opening_size = Vector2(180, 160)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 300.0
headroom = 160.0

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"rope_shaft_out"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1280, 300)
opening_size = Vector2(180, 180)
support_top = 300.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 300.0
headroom = 180.0

[sub_resource type="Resource" id="LowerOccupier"]
script = ExtResource("4")
id = &"shaft_lower_occupier"
allowed_pressure_roles = Array[StringName]([&"occupier"])
