has_line_of_sight = false
has_cover_or_elevation = true

[sub_resource type="Resource" id="MidLeaper"]
script = ExtResource("4")
id = &"shaft_mid_leaper"
allowed_pressure_roles = Array[StringName]([&"vertical"])
support_width = 220.0
lane_width = 420.0
clearance = 200.0
