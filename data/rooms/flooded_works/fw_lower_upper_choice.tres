[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/flooded_works/FwLowerUpperChoice.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomRewardAnchorData.gd" id="4"]

[sub_resource type="Resource" id="EntrySocket"]
script = ExtResource("2")
id = &"flooded_choice_in"
direction = &"left"
route_role = &"critical"
local_position = Vector2(0, 620)
opening_size = Vector2(180, 160)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 280.0
landing_width = 280.0
headroom = 160.0

[sub_resource type="Resource" id="ReturnSocket"]
script = ExtResource("2")
id = &"flooded_choice_return"
direction = &"down"
route_role = &"return"
local_position = Vector2(1216, 720)
opening_size = Vector2(128, 120)
support_top = 620.0
transition_type = &"rope"
required_ability = &"climb"
approach_width = 220.0
landing_width = 220.0
headroom = 120.0
recovery_id = &"choice_lower_recovery"

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"flooded_choice_out"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1280, 620)
opening_size = Vector2(180, 160)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 280.0
landing_width = 280.0
headroom = 160.0

[sub_resource type="Resource" id="BranchSocket"]
script = ExtResource("2")
id = &"flooded_choice_branch"
direction = &"down"
route_role = &"optional"
local_position = Vector2(320, 720)
opening_size = Vector2(128, 120)
support_top = 620.0
transition_type = &"drop"
required_ability = &"baseline"
approach_width = 220.0
landing_width = 220.0
headroom = 120.0
recovery_id = &"choice_lower_recovery"

[sub_resource type="Resource" id="UpperReward"]
script = ExtResource("4")
id = &"flooded_upper_reward"
reward_role = &"route_choice"
eligible_table_ids = Array[StringName]([&"optional_cache_ruin"])
risk_tier = 1
interaction_space = Vector2(140, 100)
budget_cost = 1

[resource]
script = ExtResource("1")
id = &"fw_lower_upper_choice"
display_name = "Flooded Lower / Upper Choice"
content_version = 2
scene = ExtResource("3")
role = &"choice"
stage_tags = Array[StringName]([&"flooded_works"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket"), SubResource("ReturnSocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket"), SubResource("BranchSocket")])
encounter_budget = Vector2i(0, 0)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(1, 1)
reward_anchors = Array[ExtResource("4")]([SubResource("UpperReward")])
recovery_anchor_ids = Array[StringName]([&"choice_lower_recovery"])
estimated_seconds = Vector2i(25, 45)
