[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/flooded_works/FwLeaperBasin.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomEnemyAnchorData.gd" id="4"]

[sub_resource type="Resource" id="EntrySocket"]
script = ExtResource("2")
id = &"leaper_basin_in"
direction = &"left"
route_role = &"critical"
local_position = Vector2(0, 620)
opening_size = Vector2(180, 160)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 300.0
landing_width = 300.0
headroom = 160.0

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"leaper_basin_out"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1280, 600)
opening_size = Vector2(180, 180)
support_top = 600.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 320.0
landing_width = 320.0
headroom = 180.0

[sub_resource type="Resource" id="LeaperAnchor"]
script = ExtResource("4")
id = &"leaper_arc"
allowed_pressure_roles = Array[StringName]([&"vertical"])
support_width = 600.0
lane_width = 420.0
clearance = 180.0
has_escape_route = true
has_line_of_sight = false
has_cover_or_elevation = true

[resource]
script = ExtResource("1")
id = &"fw_leaper_basin"
display_name = "Leaper Basin"
content_version = 1
scene = ExtResource("3")
role = &"combat"
stage_tags = Array[StringName]([&"flooded_works"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(2, 2)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
allowed_enemy_tags = Array[StringName]([&"vertical"])
forbidden_pairs = Array[StringName]([&"timed_poison_vent"])
enemy_anchors = Array[ExtResource("4")]([SubResource("LeaperAnchor")])
recovery_anchor_ids = Array[StringName]([&"basin_entry_recovery", &"basin_side_recovery"])
estimated_seconds = Vector2i(25, 45)
variant_group = &"flooded_leaper_lesson"
