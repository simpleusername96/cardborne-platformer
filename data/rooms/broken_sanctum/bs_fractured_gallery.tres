[resource]
script = ExtResource("1")
id = &"bs_fractured_gallery"
display_name = "Fractured Combat Gallery"
content_version = 2
scene = ExtResource("3")
role = &"combat"
stage_tags = Array[StringName]([&"broken_sanctum"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
