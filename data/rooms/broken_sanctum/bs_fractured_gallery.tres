exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(5, 6)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
allowed_enemy_tags = Array[StringName]([&"burst", &"vertical", &"ranged", &"occupier"])
forbidden_pairs = Array[StringName]([&"timed_poison_vent"])
enemy_anchors = Array[ExtResource("4")]([SubResource("ChargerAnchor"), SubResource("LeaperAnchor"), SubResource("ShooterAnchor"), SubResource("OccupierAnchor")])
recovery_anchor_ids = Array[StringName]([&"fracture_entry_recovery", &"fracture_exit_recovery"])
estimated_seconds = Vector2i(35, 65)
variant_group = &"sanctum_mixed_combat"
