[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/broken_sanctum/BsReliquaryCache.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomRewardAnchorData.gd" id="4"]

[sub_resource type="Resource" id="BranchSocket"]
script = ExtResource("2")
id = &"reliquary_cache_branch"
direction = &"branch"
route_role = &"optional"
local_position = Vector2(600, 720)
opening_size = Vector2(128, 160)
support_top = 580.0
transition_type = &"rope"
required_ability = &"climb"
approach_width = 280.0
landing_width = 320.0
headroom = 160.0
recovery_id = &"cache_entry_recovery"

[sub_resource type="Resource" id="ReturnSocket"]
script = ExtResource("2")
id = &"reliquary_cache_return"
direction = &"rejoin"
route_role = &"return"
local_position = Vector2(1040, 720)
opening_size = Vector2(160, 160)
support_top = 620.0
transition_type = &"drop"
required_ability = &"baseline"
approach_width = 240.0
landing_width = 240.0
headroom = 160.0
recovery_id = &"cache_return_recovery"

[sub_resource type="Resource" id="CloisterBranchSocket"]
script = ExtResource("2")
id = &"reliquary_cache_cloister_branch"
direction = &"down"
route_role = &"optional"
local_position = Vector2(960, 720)
opening_size = Vector2(128, 160)
support_top = 620.0
transition_type = &"rope"
required_ability = &"climb"
approach_width = 260.0
landing_width = 260.0
headroom = 160.0
recovery_id = &"cache_cloister_entry_recovery"

[sub_resource type="Resource" id="SentryReturnSocket"]
script = ExtResource("2")
id = &"reliquary_cache_sentry_return"
direction = &"down"
route_role = &"return"
local_position = Vector2(1280, 720)
opening_size = Vector2(160, 160)
support_top = 620.0
transition_type = &"drop"
required_ability = &"baseline"
approach_width = 220.0
landing_width = 240.0
headroom = 160.0
recovery_id = &"cache_return_recovery"

[sub_resource type="Resource" id="CacheReward"]
script = ExtResource("4")
id = &"reliquary_cache_reward"
reward_role = &"cache_reward"
eligible_table_ids = Array[StringName]([&"optional_cache_ruin"])
risk_tier = 2
interaction_space = Vector2(160, 110)
budget_cost = 1

[resource]
script = ExtResource("1")
id = &"bs_reliquary_cache"
display_name = "Upper Reliquary Cache"
content_version = 3
scene = ExtResource("3")
role = &"optional"
stage_tags = Array[StringName]([&"broken_sanctum"])
required_route = false
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("BranchSocket"), SubResource("CloisterBranchSocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ReturnSocket"), SubResource("SentryReturnSocket")])
encounter_budget = Vector2i(0, 0)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(1, 1)
reward_anchors = Array[ExtResource("4")]([SubResource("CacheReward")])
recovery_anchor_ids = Array[StringName]([&"cache_entry_recovery", &"cache_cloister_entry_recovery", &"cache_return_recovery"])
estimated_seconds = Vector2i(20, 35)
