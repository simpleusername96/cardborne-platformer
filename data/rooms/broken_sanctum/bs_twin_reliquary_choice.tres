[resource]
script = ExtResource("1")
id = &"bs_twin_reliquary_choice"
display_name = "Twin Reliquary Choice"
content_version = 3
scene = ExtResource("3")
role = &"choice"
stage_tags = Array[StringName]([&"broken_sanctum"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("CriticalEntry"), SubResource("LowerReturn"), SubResource("UpperReturn")])
exit_sockets = Array[ExtResource("2")]([SubResource("CriticalExit"), SubResource("LowerBranch"), SubResource("UpperBranch")])
encounter_budget = Vector2i(0, 0)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
recovery_anchor_ids = Array[StringName]([&"choice_entry_recovery", &"choice_main_recovery", &"upper_return_recovery"])
estimated_seconds = Vector2i(25, 50)
