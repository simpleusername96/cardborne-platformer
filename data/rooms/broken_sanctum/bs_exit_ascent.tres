[gd_resource type="Resource" script_class="RoomTemplateData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/stages/RoomTemplateData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/stages/RoomSocketData.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/broken_sanctum/BsExitAscent.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/stages/RoomEnemyAnchorData.gd" id="4"]

[sub_resource type="Resource" id="EntrySocket"]
script = ExtResource("2")
id = &"sanctum_exit_in"
direction = &"left"
route_role = &"critical"
local_position = Vector2(0, 620)
opening_size = Vector2(180, 180)
support_top = 620.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 280.0
landing_width = 280.0
headroom = 180.0

[sub_resource type="Resource" id="ExitSocket"]
script = ExtResource("2")
id = &"sanctum_exit_out"
direction = &"right"
route_role = &"critical"
local_position = Vector2(1280, 380)
opening_size = Vector2(180, 200)
support_top = 380.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 250.0
landing_width = 250.0
headroom = 200.0

[sub_resource type="Resource" id="UpperOccupierAnchor"]
script = ExtResource("4")
id = &"exit_upper_occupier"
allowed_pressure_roles = Array[StringName]([&"occupier"])
support_width = 250.0
lane_width = 200.0
clearance = 180.0
has_escape_route = true
has_line_of_sight = false
has_cover_or_elevation = true

[resource]
script = ExtResource("1")
id = &"bs_exit_ascent"
display_name = "Broken Sanctum Exit Ascent"
content_version = 3
scene = ExtResource("3")
role = &"exit"
stage_tags = Array[StringName]([&"broken_sanctum"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(2, 2)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
allowed_enemy_tags = Array[StringName]([&"occupier"])
enemy_anchors = Array[ExtResource("4")]([SubResource("UpperOccupierAnchor")])
recovery_anchor_ids = Array[StringName]([&"exit_entry_recovery", &"exit_ascent_recovery"])
estimated_seconds = Vector2i(20, 40)
