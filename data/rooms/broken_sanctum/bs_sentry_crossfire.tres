opening_size = Vector2(180, 180)
support_top = 556.0
transition_type = &"seam"
required_ability = &"baseline"
approach_width = 320.0
landing_width = 320.0
headroom = 180.0

[sub_resource type="Resource" id="ReliquaryRejoinSocket"]
script = ExtResource("2")
id = &"sentry_reliquary_rejoin"
direction = &"up"
route_role = &"return"
