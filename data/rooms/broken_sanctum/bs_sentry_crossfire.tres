support_width = 240.0
lane_width = 760.0
clearance = 260.0
has_escape_route = true
has_line_of_sight = true
has_cover_or_elevation = true

[resource]
script = ExtResource("1")
id = &"bs_sentry_crossfire"
display_name = "Sanctum Sentry Crossfire"
content_version = 3
scene = ExtResource("3")
role = &"combat"
stage_tags = Array[StringName]([&"broken_sanctum"])
required_route = true
bounds = Rect2(0, 0, 1280, 720)
entry_sockets = Array[ExtResource("2")]([SubResource("EntrySocket"), SubResource("ReliquaryRejoinSocket")])
exit_sockets = Array[ExtResource("2")]([SubResource("ExitSocket")])
encounter_budget = Vector2i(6, 6)
hazard_budget = Vector2i(0, 0)
reward_budget = Vector2i(0, 0)
allowed_enemy_tags = Array[StringName]([&"zone"])
forbidden_pairs = Array[StringName]([&"timed_poison_vent", &"crumbling_platform"])
enemy_anchors = Array[ExtResource("4")]([SubResource("WestSentryAnchor"), SubResource("EastSentryAnchor")])
recovery_anchor_ids = Array[StringName]([&"crossfire_entry_recovery", &"crossfire_center_recovery"])
estimated_seconds = Vector2i(35, 60)
variant_group = &"sanctum_mixed_combat"
