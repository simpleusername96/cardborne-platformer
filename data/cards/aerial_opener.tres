[gd_resource type="Resource" script_class="CardDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/cards/CardDefinition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/cards/CardEffectDefinition.gd" id="2"]

[sub_resource type="Resource" id="Damage"]
script = ExtResource("2")
effect_type = &"add_damage"
damage = 1

[sub_resource type="Resource" id="Stagger"]
script = ExtResource("2")
effect_type = &"add_stagger"
stagger = 20

[resource]
script = ExtResource("1")
id = &"aerial_opener"
display_name = "Aerial Opener"
description = "The first attack after your extra jump gains 1 damage and 20 stagger."
rarity = &"common"
compatibility = Array[StringName]([&"shared"])
trigger = &"first_attack_after_extra_jump"
effects = Array[ExtResource("2")]([SubResource("Damage"), SubResource("Stagger")])
max_stacks = 1
