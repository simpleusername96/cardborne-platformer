[gd_resource type="Resource" script_class="VehicleUpgradeDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/cards/vehicle_upgrade_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/cards/vehicle_stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="Modifier_1"]
script = ExtResource("2_mod")
stat_id = &"lifesteal_percent"
operation = "add"
display_unit = "percent"
level_zero_display_override_enabled = true
level_zero_display_value = 0.5
values_by_level = Array[float]([1.5, 2.2, 2.9, 3.6, 4.2])

[resource]
script = ExtResource("1_def")
id = &"lifesteal"
title_key = "UPGRADE_LIFESTEAL_TITLE"
description_key = "UPGRADE_LIFESTEAL_DESC"
category = &"chassis"
artwork_asset_id = &"upgrade/lifesteal"
max_level = 5
modifiers = Array[ExtResource("2_mod")]([SubResource("Modifier_1")])
