[resource]
script = ExtResource("1_def")
id = &"rapid_cycle"
title_key = "UPGRADE_RAPID_CYCLE_TITLE"
description_key = "UPGRADE_RAPID_CYCLE_DESC"
summary_keys = Array[String](["UPGRADE_RAPID_CYCLE_DESC", "UPGRADE_RAPID_CYCLE_DESC", "UPGRADE_RAPID_CYCLE_DESC"])
family = &"primary"
artwork_asset_id = &"projectile/energy_teardrop"
