[gd_resource type="Resource" script_class="VehicleUpgradeDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/cards/vehicle_upgrade_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/cards/vehicle_stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="Modifier_1"]
script = ExtResource("2_mod")
stat_id = &"primary_range"
operation = "multiply"
values_by_level = Array[float]([1.15, 1.3225])

[sub_resource type="Resource" id="Modifier_2"]
script = ExtResource("2_mod")
stat_id = &"primary_spread"
operation = "multiply"
values_by_level = Array[float]([0.7, 0.49])

[resource]
script = ExtResource("1_def")
id = &"stabilizer"
title_key = "UPGRADE_STABILIZER_TITLE"
description_key = "UPGRADE_STABILIZER_DESC"
summary_keys = Array[String](["UPGRADE_STABILIZER_DESC", "UPGRADE_STABILIZER_DESC"])
family = &"primary"
artwork_asset_id = &"projectile/energy_teardrop"
max_level = 2
source_tags = Array[StringName]([&"level_up", &"boss"])
modifiers = Array[ExtResource("2_mod")]([SubResource("Modifier_1"), SubResource("Modifier_2")])
