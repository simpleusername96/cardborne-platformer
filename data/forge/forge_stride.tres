[gd_resource type="Resource" script_class="ForgeAffixDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/progression/ForgeAffixDefinition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/player/EffectDefinition.gd" id="2"]

[sub_resource type="Resource" id="MoveSpeed"]
script = ExtResource("2")
stat_id = &"move_speed"
value = 10.0
source_id = &"forge_stride"
source_scope = "temporary"

[sub_resource type="Resource" id="AirAcceleration"]
script = ExtResource("2")
stat_id = &"air_acceleration"
operation = "multiply"
value = 1.05
source_id = &"forge_stride"
source_scope = "temporary"

[resource]
script = ExtResource("1")
id = &"forge_stride"
display_name = "Stride"
mechanical_description = "+10 move speed and air acceleration x1.05 for this run."
eligible_slots = Array[StringName]([&"weapon", &"armor", &"charm", &"relic"])
build_effects = Array[ExtResource("2")]([SubResource("MoveSpeed"), SubResource("AirAcceleration")])
